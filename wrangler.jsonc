{
	// Cloudflare Workers 配置（jsonc 支持注释；旧的 wrangler.toml 已弃用）
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "market-data-lake-worker",
	"main": "src/index.ts",
	"compatibility_date": "2025-04-01",
	// 使用 aws4fetch（纯 fetch + SigV4），不依赖 Node API，所以不开 nodejs_compat。
	// 移除 nodejs_compat 也避开了它对 module 加载语义的潜在副作用。
	// Cron Triggers：每 2 分钟一次。每次 invocation ROUNDS=2 × BATCH_SIZE=50 = 100 个作业，
	//   即 50 jobs/min（比原 */5 提速 5×；东方财富 CN 串行限速避免 520）。
	//   subrequest ≈ 404，远低于 Paid tier 1000 上限。3658 条全量 ≈ 1.2 小时扫完一遍。
	// 改 schedule 必须重 deploy；运行期开关在 admin 后台（system_config.cron_enabled）
	"triggers": {
		"crons": [
			"*/2 * * * *"
		]
	},
	// D1 绑定：先用 `wrangler d1 create market-data-lake` 创建库，再把返回的 id 填到下面
	"d1_databases": [
		{
			"binding": "market_data_lake",
			"database_name": "market-data-lake",
			"database_id": "35987c18-877a-415c-8569-3020bf4f9207",
			"remote": true
		}
	],
	// 打开 observability 方便在仪表盘看日志（可选）
	"observability": {
		"enabled": true
	},
	// 公开变量（敏感项请走 `wrangler secret put`，不要写进 vars）
	"vars": {
		// —— S3 凭证（敏感的 access key / secret key 走 secret，不在 vars） ——
		"S3_ENDPOINT": "https://oss-cn-shanghai.aliyuncs.com",
		// 阿里云 OSS S3-SigV4 签名 region 是 cn-shanghai（不带 oss- 前缀）
		"S3_REGION": "cn-shanghai",
		"S3_BUCKET": "market-data-cf",
		// —— Cloudflare Access ——
		"ACCESS_TEAM_DOMAIN": "newone1997.cloudflareaccess.com",
		"ACCESS_AUD": "2189fa861234855f5f55eb3679bac31bd7cd715aa6a9108666628001f7df5d14",
		// 本地 wrangler dev 时建议在 `.dev.vars` 中覆盖为 development，access-auth 中间件会自动跳过
		"ENVIRONMENT": "production"
	}
}