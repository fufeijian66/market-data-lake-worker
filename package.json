{
  "name": "market-data-lake-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "db:init": "wrangler d1 execute market_data_lake --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute market_data_lake --remote --file=./schema.sql"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251101.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.87.0"
  }
}
